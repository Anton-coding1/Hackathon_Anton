# Server-side only. Never commit a real key.
GEMINI_API_KEY=your-key-here
# Lead brain (attacker, defender, floor-plan reading). Default: gemini-4-argon
GEMINI_MODEL=gemini-4-argon
# Fast subagent (follow-up fixes found by the sweep, live cost grounding). Default: gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.8-flash
